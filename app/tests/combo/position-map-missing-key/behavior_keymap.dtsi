#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/kscan_mock.h>
#include <dt-bindings/zmk/matrix_transform.h>

/*
 * A stock 2x2 layout and an alternate 3-key layout that omits the physical key RC(0,1).
 *
 *   physical key  stock position  alt position
 *   RC(0,0)             0             0
 *   RC(0,1)             1             (absent)
 *   RC(1,0)             2             1
 *   RC(1,1)             3             2
 */

/ {
    chosen {
        /delete-property/ zmk,kscan;
        zmk,physical-layout = &stock_layout;
    };

    stock_transform: stock_transform {
        compatible = "zmk,matrix-transform";
        columns = <2>;
        rows = <2>;
        map = <RC(0,0) RC(0,1) RC(1,0) RC(1,1)>;
    };

    alt_transform: alt_transform {
        compatible = "zmk,matrix-transform";
        columns = <2>;
        rows = <2>;
        map = <RC(0,0) RC(1,0) RC(1,1)>;
    };

    stock_layout: stock_layout {
        compatible = "zmk,physical-layout";
        display-name = "Stock";
        kscan = <&kscan>;
        transform = <&stock_transform>;
    };

    alt_layout: alt_layout {
        compatible = "zmk,physical-layout";
        display-name = "Alt";
        kscan = <&kscan>;
        transform = <&alt_transform>;
    };

    position_map {
        compatible = "zmk,physical-layout-position-map";
        complete;

        stock {
            physical-layout = <&stock_layout>;
            positions = <0 2 3>;
        };

        alt {
            physical-layout = <&alt_layout>;
            positions = <0 1 2>;
        };
    };

    behaviors {
        select_layout: select_layout {
            compatible = "zmk,behavior-select-physical-layout";
            #binding-cells = <1>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Uses RC(0,1) (stock position 1), which does not exist in the alt layout.
        combo_top_row {
            timeout-ms = <30>;
            key-positions = <0 1>;
            bindings = <&kp C>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Stock positions: 0 RC(0,0)=A, 1 RC(0,1)=B, 2 RC(1,0)=D, 3 RC(1,1)=select_layout 1
        default_layer {
            bindings = <
                &kp A &kp B
                &kp D &select_layout 1
            >;
        };
    };
};
